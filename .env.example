# Used only by `npm run dev` via /api/interpret (key stays on the Vite server).
# Grok Bot chat / Cursor credits do NOT fill this in — you need a console.x.ai key.
#
# xAI Grok (recommended for this project):
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.6
#
# OpenAI alternative:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
